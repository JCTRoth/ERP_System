# Playwright E2E configuration (copy to .env or export in your shell).
# All values are optional — sensible defaults matching the seeded demo stack are used.

# Base URL of the ERP frontend (vite dev server, or the compose frontend in CI)
# E2E_BASE_URL=http://localhost:5173

# Base URL of the webshop (vite dev server on port 3008, or the compose webshop in CI)
# E2E_WEBSHOP_URL=http://localhost:3008

# Seeded super admin credentials (see UserService UserDbContext seed).
# E2E_USER_EMAIL=admin@erp-system.local
# E2E_USER_PASSWORD=Admin123!
