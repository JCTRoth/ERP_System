{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    // Consistent with apps/frontend and apps/webshop (pinned TS 5.x accepts
    // only "5.0"; the baseUrl deprecation note in newer language servers is a
    // pre-existing workspace-wide artifact).
    "ignoreDeprecations": "5.0"
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "utils/**/*.ts"]
}
